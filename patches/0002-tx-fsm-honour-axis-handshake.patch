Subject: [PATCH] riscv_pcie_soc: advance the TX FSM only on an accepted beat

s_axis_tx_* are registered, but the FSM tested s_axis_tx_tready in the
cycle it scheduled them, i.e. against whatever was on the bus before.
With an always-ready sink the errors cancel; under backpressure beat 0
(the TLP header) is overwritten by beat 1 before it is accepted, and
tvalid can drop while a beat is pending (AXI4-Stream 2.2.1). The FSM
now advances only when the beat on the bus is taken, and IDLE holds
the final beat until accepted.

Found by the openpcie-uvm Tier 1 testbench (TX-PROTO-004); see
docs/verification_plan.md, section 11, in that repository.

---
--- a/2.rtl/2.RC-direct.opensource/src/riscv_pcie_soc.sv
+++ b/2.rtl/2.RC-direct.opensource/src/riscv_pcie_soc.sv
@@ -189,24 +189,28 @@
             end
 
             case (tx_state)
+                // Advance only when the beat on the bus is accepted
+                // (AXI4-Stream: hold tvalid/tdata until tready).
                 IDLE: begin
-                    s_axis_tx_tvalid <= 1'b0;
+                    if (!s_axis_tx_tvalid || s_axis_tx_tready)
+                        s_axis_tx_tvalid <= 1'b0;
                 end
                 SEND_CYCLE_1: begin
-                    s_axis_tx_tdata  <= {tx_header1, tx_header0};
-                    s_axis_tx_tkeep  <= 8'hFF;
-                    s_axis_tx_tvalid <= 1'b1;
-                    s_axis_tx_tlast  <= 1'b0;
-                    if (s_axis_tx_tready) tx_state <= SEND_CYCLE_2;
+                    if (!s_axis_tx_tvalid || s_axis_tx_tready) begin
+                        s_axis_tx_tdata  <= {tx_header1, tx_header0};
+                        s_axis_tx_tkeep  <= 8'hFF;
+                        s_axis_tx_tvalid <= 1'b1;
+                        s_axis_tx_tlast  <= 1'b0;
+                        tx_state         <= SEND_CYCLE_2;
+                    end
                 end
                 SEND_CYCLE_2: begin
-                    s_axis_tx_tdata  <= {tx_data, tx_header2};
-                    s_axis_tx_tkeep  <= (tx_header0[30] == 1'b1) ? 8'hFF : 8'h0F;
-                    s_axis_tx_tvalid <= 1'b1;
-                    s_axis_tx_tlast  <= 1'b1;
-
                     if (s_axis_tx_tready) begin
-                        tx_state <= IDLE;
+                        s_axis_tx_tdata  <= {tx_data, tx_header2};
+                        s_axis_tx_tkeep  <= (tx_header0[30] == 1'b1) ? 8'hFF : 8'h0F;
+                        s_axis_tx_tvalid <= 1'b1;
+                        s_axis_tx_tlast  <= 1'b1;
+                        tx_state         <= IDLE;
                     end
                 end
                 default: ;
